# Python
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
.venv-*/

# Local secrets (API keys) — never commit
keys.txt
.probe/

# Local TLS material (private CA + server key) — never commit
certs/

# Live-smoke scratch paper (used by .probe/ scripts)
.smoke-paper/

# Per-project app state (SPEC §7) — rides Syncthing, never committed
.phd-helper/

# Server-side app state (last-used project, §7) — never committed
.phd-helper-server/

# Build artifacts
*.egg-info/

# Throwaway prototype scratch (source promoted to src/; logs only remain)
prototype/

# Corpus store: PDFs + registry on the server filesystem (Syncthing-replicated)
corpus_data/

# MinerU 4.0's content-addressed parse cache (written to the CLI's cwd)
blobs/
